# ── Add these to /opt/hermes-webui/.env ───────────────────────────────────
# (alongside whatever is already there)

# Custom assistant name shown in the UI
HERMES_WEBUI_BOT_NAME=Trading Agent

# Inject a "Back to GizzyFx Engine" link at the top of every new session
HERMES_WEBUI_PREFILL_MESSAGES_SCRIPT=/opt/hermes-webui/hermes/prefill.sh

# Allow the Hermes console to open the GizzyFx engine in a frame (optional)
HERMES_WEBUI_CSP_CONNECT_EXTRA=https://gizzyfxstrategy.dpdns.org
